{
  "compilerOptions": {
    "target": "es2023", "lib": ["ES2023", "DOM"], "module": "nodenext", "moduleResolution": "nodenext", "types": ["node"],
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "noEmit": true, "strict": true, "skipLibCheck": true,
