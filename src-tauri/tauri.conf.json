{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbit",
  "version": "0.6.42",
  "identifier": "ai.pi.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "node scripts/bundle-pi.mjs && node node_modules/typescript/bin/tsc -b && node node_modules/typescript/bin/tsc -p tsconfig.computer-use.json && node node_modules/vite/bin/vite.js build",
    "beforeBundleCommand": "node scripts/sync-worker.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbit",
        "visible": false,
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 640,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5MEM1MjBFNDUwREVDMTAKUldRUTdBMUZEbElNYWRINzZkMWNreEoyL2k5eGxXenpHTE1PTiswQnhTT0UxeWptOTdzMUZ5WFgK",
      "endpoints": [
        "https://github.com/ErKeLost/Orbit/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": [
          "nodejs (>= 22.19.0)"
        ]
      },
      "rpm": {
        "depends": []
      }
    },
    "resources": [
      "resources/gui-extension.ts",
      "resources/context-payload.ts",
      "resources/workspace.ts",
      "resources/subagents",
      "resources/computer-use",
      "resources/node_modules",
      "resources/node-runtime",
      "resources/pi-runtime"
    ]
  }
}
